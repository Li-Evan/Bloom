# 复制为 .env（make setup 会复制并生成 BACKEND_JWT_SECRET）。后端和 docker compose 都读这个文件。

# 模型：任何 OpenAI 兼容的聊天补全接口都行
# OpenAI:    LLM_BASE_URL=https://api.openai.com/v1                          LLM_MODEL=gpt-4.1-mini
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1                        LLM_MODEL=deepseek-chat
# 通义千问:   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# Ollama:    LLM_BASE_URL=http://localhost:11434/v1                          LLM_MODEL=qwen3（LLM_API_KEY 随便填）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# 知识地图、知识坐标、划线翻译用的小模型；留空和 LLM_MODEL 一样
LLM_FAST_MODEL=
# PDF 阅读版逐页看图转文字用的模型，必须能看图；留空和 LLM_MODEL 一样
PDF_READING_MODEL=
# 原样带进每次模型调用的 extra_body（JSON 对象），例如给 DeepSeek 关掉推理：{"thinking":{"type":"disabled"}}
LLM_EXTRA_BODY=
# 输出上限的参数名：留空按模型名自动判断（gpt- / o 系列用 max_completion_tokens，其它用 max_tokens）
LLM_MAX_TOKENS_PARAM=

# 前端服务端给后端签访问令牌用的密钥，至少 32 个字符；前后端用同一个值
BACKEND_JWT_SECRET=

# 数据库：默认是 backend/storage/bloom.sqlite3；也可以用 Postgres，例如
# DATABASE_URL=postgresql://bloom:bloom@localhost:5432/bloom

# 可选：把模型调用记到 Langfuse（https://langfuse.com）
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
