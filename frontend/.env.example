# 本地开发（pnpm dev）时复制为 .env.local。用 docker compose 时不需要这个文件：仓库根目录的 .env 统一提供。

# 前端服务端访问后端的地址。浏览器只请求同源的 /api/backend/…，不直接连后端，所以不需要 CORS
BACKEND_URL=http://localhost:8000
# 必须和后端用的同一个值（仓库根目录 .env 里的 BACKEND_JWT_SECRET）
BACKEND_JWT_SECRET=

NEXT_PUBLIC_LOCALE_DETECTION=true
NEXT_PUBLIC_DEFAULT_THEME=system
